#cloud-config
#
# This file configures the new virtual machine on its first boot.
#
# Set a default user and password.
# IMPORTANT: Change the password below to something secure!
user: {{ vm_user | default('ubuntu') }}
password: {{ vm_password | default('YourSecurePassword!') }}
chpasswd: { expire: False }

# Allow SSH password authentication for convenience in a lab.
ssh_pwauth: True

# Add the user to the sudo group to allow administrative tasks.
groups: [sudo]
shell: /bin/bash

# Optional: For better security, you can add your SSH public key here
# for passwordless login. This is the recommended method for production.
# ssh_authorized_keys:
#   - ssh-rsa AAAA... your-key-name
